# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGO_URI=mongodb://127.0.0.1:27017/feeflow

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Comma-separated list of additional allowed origins (e.g. a custom domain).
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed regardless of
# this value, and any *.netlify.app origin (deploy previews included) is allowed
# automatically — see src/app.js. Set this to your production frontend URL(s).
CORS_ORIGIN=https://feesapp.netlify.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Business rules
PARTIAL_PAYMENT_PERCENTAGE=50
RECEIPT_PREFIX=RCT
RECEIPT_START_NUMBER=100000

# Mail (optional - Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FeeFlow <no-reply@feeflow.app>

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Seed admin
SEED_ADMIN_EMAIL=admin@feeflow.app
SEED_ADMIN_PASSWORD=Admin@12345
